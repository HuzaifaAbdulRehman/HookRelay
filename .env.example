NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://hookrelay:hookrelay@localhost:5432/hookrelay
REDIS_URL=redis://localhost:6379

# Development only. Lets deliveries reach localhost. Never set this where
# someone else supplies destination URLs.
ALLOW_PRIVATE_DESTINATIONS=false

# Guards the management routes (GET /events/:id, POST /events/:id/replay).
# Omit it entirely and those routes are not registered at all.
# Minimum 16 characters; a blank value is rejected rather than ignored.
API_KEY=change-me-to-a-long-random-string
